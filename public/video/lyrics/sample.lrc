[offset:0]

# ─────────────────────────────────────────────────────────────
#  LRC 자막 템플릿
#
#  ⚠ 이 저장소에는 가사 텍스트를 커밋하지 않습니다.
#     이 파일을 복사해 (예: my-song.lrc) 직접 쓰실 곡의 가사를 채운 뒤
#     video.project.json 의 lyrics.lrcSrc 를 그 파일로 가리키세요.
#     상업적으로 공개 배포할 영상이라면 음원/가사 이용 권리를 먼저 확인하세요.
#
#  문법
#    [mm:ss.xx] 가사 한 줄
#    [mm:ss.xx]              ← 텍스트 없는 줄 = 간주 (음표 인디케이터 표시)
#    [mm:ss.xx][mm:ss.xx] 후렴   ← 같은 줄을 여러 시각에 재사용
#    [offset:-300]           ← 전체 자막을 300ms 앞당김 (음수=빨리)
#
#  단어별 하이라이트(가라오케)를 쓰려면 enhanced 문법:
#    [00:20.00]<00:20.00>우리 <00:20.60>함께 <00:21.30>걷던 <00:22.00>그 길
#
#  가장 쉬운 만드는 법: 스튜디오(#/studio)의 [가사] 탭에서
#  음악을 재생하며 "지금 이 줄" 버튼을 눌러 타임스탬프를 찍고 내보내기.
# ─────────────────────────────────────────────────────────────

[00:00.00]
[00:08.00]첫 번째 줄이 여기에 들어갑니다
[00:13.50]두 번째 줄
[00:19.00]
[00:24.00]간주 뒤에 이어지는 줄
[00:30.00]<00:30.00>단어별 <00:30.70>하이라이트도 <00:31.60>이렇게
[00:37.00]마지막 줄
[00:43.00]
